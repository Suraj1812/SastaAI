# Public SEO URL (never put API keys in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_SITE_URL=https://sasta-ai.surajsinghrajput1812.workers.dev

# Optional server-only Python URL. Development defaults to port 8000;
# production uses the portable Next.js engine if this is unset.
# SASTA_PYTHON_API_URL=http://127.0.0.1:8000

# Optional Python provider configuration; keyless mode uses Wikipedia.
# Export these in the Python process environment, not browser code.
SERPAPI_API_KEY=

# Optional answer synthesis. Without this, Sasta AI returns extracted source evidence.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
